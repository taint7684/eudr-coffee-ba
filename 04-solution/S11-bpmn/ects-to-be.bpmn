<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="ects_defs" targetNamespace="https://github.com/taint7684/eudr-coffee-ba">
  <bpmn:collaboration id="collab">
    <bpmn:participant id="pool" name="ECTS — Quy trình To-Be cấp 1 (S11)" processRef="ects_tobe" />
  </bpmn:collaboration>
  <bpmn:process id="ects_tobe" isExecutable="false">
    <bpmn:laneSet id="ls">
      <bpmn:lane id="lane0" name="Đại lý"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>t2a</bpmn:flowNodeRef><bpmn:flowNodeRef>g2</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>t8</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="lane1" name="Hệ thống ECTS"><bpmn:flowNodeRef>t2b</bpmn:flowNodeRef><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>g3</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="lane2" name="Tuân thủ (DN)"><bpmn:flowNodeRef>t6</bpmn:flowNodeRef><bpmn:flowNodeRef>g4</bpmn:flowNodeRef><bpmn:flowNodeRef>endx</bpmn:flowNodeRef><bpmn:flowNodeRef>t10</bpmn:flowNodeRef><bpmn:flowNodeRef>t11</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="lane3" name="Thu mua (DN)"><bpmn:flowNodeRef>t9</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="lane4" name="Nhà nhập khẩu EU"><bpmn:flowNodeRef>t12</bpmn:flowNodeRef><bpmn:flowNodeRef>g5</bpmn:flowNodeRef><bpmn:flowNodeRef>endok</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Nông hộ đồng ý tham gia"><bpmn:outgoing>f_start_t1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="t1" name="Đăng ký nông hộ + đồng ý dữ liệu [BR-006]"><bpmn:incoming>f_start_t1</bpmn:incoming><bpmn:outgoing>f_t1_g1</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Lô &gt; 4 ha?"><bpmn:incoming>f_t1_g1</bpmn:incoming><bpmn:outgoing>f_g1_t2a</bpmn:outgoing><bpmn:outgoing>f_g1_t2b</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t2a" name="Lấy điểm GPS [BR-001]"><bpmn:incoming>f_g1_t2a</bpmn:incoming><bpmn:outgoing>f_t2a_g2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="t2b" name="Vẽ đa giác ranh lô [BR-002, BR-003]"><bpmn:incoming>f_g1_t2b</bpmn:incoming><bpmn:outgoing>f_t2b_g2</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name=""><bpmn:incoming>f_t2a_g2</bpmn:incoming><bpmn:incoming>f_t2b_g2</bpmn:incoming><bpmn:outgoing>f_g2_t3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t3" name="Nhập giấy tờ đất [BR-020]"><bpmn:incoming>f_g2_t3</bpmn:incoming><bpmn:outgoing>f_t3_t4</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="t4" name="Kiểm tra hình học, chồng lấn, pháp lý [BR-004, 005, 021]"><bpmn:incoming>f_t3_t4</bpmn:incoming><bpmn:outgoing>f_t4_t5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:businessRuleTask id="t5" name="Chấm rủi ro lô R1–R6 [BR-010…014]"><bpmn:incoming>f_t4_t5</bpmn:incoming><bpmn:outgoing>f_t5_g3</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="g3" name="Kết quả chấm?"><bpmn:incoming>f_t5_g3</bpmn:incoming><bpmn:outgoing>f_g3_t8</bpmn:outgoing><bpmn:outgoing>f_g3_t6</bpmn:outgoing><bpmn:outgoing>f_g3_endx</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t6" name="Xác minh Vùng xám: ảnh lịch sử / thực địa [BR-016]"><bpmn:incoming>f_g3_t6</bpmn:incoming><bpmn:outgoing>f_t6_g4</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g4" name="Kết luận?"><bpmn:incoming>f_t6_g4</bpmn:incoming><bpmn:outgoing>f_g4_t8</bpmn:outgoing><bpmn:outgoing>f_g4_endx</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="endx" name="Lô không bán dòng EU"><bpmn:incoming>f_g3_endx</bpmn:incoming><bpmn:incoming>f_g4_endx</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="t8" name="Ghi giao dịch dòng EU theo lô [BR-030, 031]"><bpmn:incoming>f_g3_t8</bpmn:incoming><bpmn:incoming>f_g4_t8</bpmn:incoming><bpmn:outgoing>f_t8_t9</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="t9" name="Nhập kho, lập lô hàng EU tách dòng [BR-032, 033]"><bpmn:incoming>f_t8_t9</bpmn:incoming><bpmn:outgoing>f_t9_t10</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="t10" name="Lập gói dữ liệu DDS [BR-040, 041]"><bpmn:incoming>f_t9_t10</bpmn:incoming><bpmn:incoming>f_g5_t10</bpmn:incoming><bpmn:outgoing>f_t10_t11</bpmn:outgoing></bpmn:userTask>
    <bpmn:sendTask id="t11" name="Gửi gói cho nhà nhập khẩu"><bpmn:incoming>f_t10_t11</bpmn:incoming><bpmn:outgoing>f_t11_t12</bpmn:outgoing></bpmn:sendTask>
    <bpmn:userTask id="t12" name="Nộp DDS lên hệ thống thông tin EU (ngoài ECTS)"><bpmn:incoming>f_t11_t12</bpmn:incoming><bpmn:outgoing>f_t12_g5</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g5" name="Kết quả DDS?"><bpmn:incoming>f_t12_g5</bpmn:incoming><bpmn:outgoing>f_g5_endok</bpmn:outgoing><bpmn:outgoing>f_g5_t10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="endok" name="Có số tham chiếu — thông quan"><bpmn:incoming>f_g5_endok</bpmn:incoming></bpmn:endEvent>
